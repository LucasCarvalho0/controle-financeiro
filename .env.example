# PostgreSQL (Supabase/Neon). DIRECT_URL = conexão direta usada pelas migrações.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/controle_financeiro?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/controle_financeiro?schema=public"

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
